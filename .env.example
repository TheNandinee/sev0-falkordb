# ---- LLM (optional: empty = deterministic planner mode)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MAX_AGENT_STEPS=10

# ---- FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
DEFAULT_TENANT=kirana

# ---- Live telemetry: built-in traffic generator plus anomaly detector
SIMULATOR=on
SIMULATOR_RPS=10
DETECTOR_INTERVAL_S=5
EDGE_TTL_S=900
DEPLOY_LOOKBACK_MIN=120

# ---- Security (empty = open demo mode)
# Comma-separated tenant:key pairs, for example kirana:sk_live_abc123,acme:sk_live_def456
SEV0_API_KEYS=
# HMAC secret for /api/webhooks/deploy (header X-Sev0-Signature: sha256=<hex>)
DEPLOY_WEBHOOK_SECRET=
INVESTIGATE_RATE_PER_MIN=10
LOG_LEVEL=INFO
